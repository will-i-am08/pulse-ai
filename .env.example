# ─── Neon (Postgres) ────────────────────────────────────────
# Connection string from `neon connection-string <branch> --project-id <id>`
DATABASE_URL=
NEON_PROJECT_ID=

# ─── Dashboard auth (single operator) ───────────────────────
OPERATOR_PASSWORD=
# openssl rand -base64 32 — signs the session cookie
AUTH_SECRET=

# ─── Anthropic (LLM drafting) ───────────────────────────────
ANTHROPIC_API_KEY=
DRAFT_MODEL=claude-haiku-4-5-20251001
FALLBACK_MODEL=claude-sonnet-5

# ─── Messaging channel ──────────────────────────────────────
# Which channel the agent sends/receives on: twilio (SMS/MMS, default), discord, or linq.
MESSAGE_CHANNEL=twilio

# Kip's contact identity (name + profile pic clients see instead of a bare number).
# Twilio: first outbound MMS attaches /api/contact/kip.vcf (save-to-contacts card).
# Linq: iMessage Name and Photo Sharing via contact_card + share_contact_card.
KIP_CONTACT_FIRST_NAME=Kip
# Optional override; defaults to ${APP_BASE_URL}/brand/kip-logo-1024.png
# KIP_CONTACT_IMAGE_URL=

# ─── Twilio (SMS/MMS gateway) ───────────────────────────────
TWILIO_ACCOUNT_SID=
# Auth Token: required for inbound webhook signature validation (API keys can't do this)
TWILIO_AUTH_TOKEN=
# API key (preferred for sending + media downloads; revocable). Optional if Auth Token is set.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
# Operator's own mobile — where operator-approver drafts and failure alerts are sent (E.164, e.g. +614...)
OPERATOR_PHONE=

# ─── Linq (iMessage/RCS/SMS end-state) ──────────────────────
# LINQ_API_KEY=
# LINQ_WEBHOOK_SECRET=
# LINQ_TEST_BRAND_ID=
# E.164 Linq sending line — required to configure Kip's iMessage contact card.
# LINQ_FROM_NUMBER=

# ─── Meta Graph API (Instagram + Facebook publishing) ───────
# MOCK until App Review clears. Set GRAPH_MODE=live once approved.
GRAPH_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ─── Security ───────────────────────────────────────────────
# 32-byte base64 key for encrypting platform_tokens at rest (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# ─── App ────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
TZ=Australia/Sydney
