# ─── Neon (Postgres) ────────────────────────────────────────
# Connection string from `neon connection-string <branch> --project-id <id>`
DATABASE_URL=
NEON_PROJECT_ID=

# ─── Dashboard auth (single operator) ───────────────────────
OPERATOR_PASSWORD=
# openssl rand -base64 32 — signs the session cookie
AUTH_SECRET=

# ─── Anthropic (LLM drafting) ───────────────────────────────
ANTHROPIC_API_KEY=
DRAFT_MODEL=claude-haiku-4-5-20251001
FALLBACK_MODEL=claude-sonnet-5
# Smart Kip routing (see docs/SMART_KIP.md). Off by default.
# SMART_MODEL=claude-sonnet-5
# KIP_SMART_ROUTING=true
# Bounded tool loop on question turns (brand/posts/calendar/kickoffs). Off by default.
# KIP_TOOL_LOOP=true
# Thin multi-step planner before kickoffs (see docs/SMART_KIP.md). Off by default.
# KIP_SMART_PLANNER=true

# ─── Messaging channel ──────────────────────────────────────
# Which channel the agent sends/receives on: twilio (SMS/MMS, default) or linq (iMessage end-state).
MESSAGE_CHANNEL=twilio

# Kip's contact identity (name + profile pic clients see instead of a bare number).
# Twilio: first outbound MMS attaches /api/contact/kip.vcf (save-to-contacts card).
# Linq: iMessage Name and Photo Sharing via contact_card + share_contact_card.
KIP_CONTACT_FIRST_NAME=Kip
# Optional override; defaults to ${APP_BASE_URL}/brand/kip-logo-1024.png
# KIP_CONTACT_IMAGE_URL=

# ─── Twilio (SMS/MMS gateway) ───────────────────────────────
TWILIO_ACCOUNT_SID=
# Auth Token: required for inbound webhook signature validation (API keys can't do this)
TWILIO_AUTH_TOKEN=
# API key (preferred for sending + media downloads; revocable). Optional if Auth Token is set.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
# Operator's own mobile — where operator-approver drafts and failure alerts are sent (E.164, e.g. +614...)
OPERATOR_PHONE=

# ─── AI cost estimates (SMS hints) + weekly AI spend cap ───
# COST_IMAGE_USD=0.04
# COST_VIDEO_USD=0.5
# COST_SPECIALTY_USD=0.12
# AI_WEEKLY_SPEND_CAP_USD=10
# RETENTION_DAYS=180

# ─── Linq (iMessage/RCS/SMS end-state) ──────────────────────
# LINQ_API_KEY=
# LINQ_WEBHOOK_SECRET=
# LINQ_TEST_BRAND_ID=
# E.164 Linq sending line — required to configure Kip's iMessage contact card.
# LINQ_FROM_NUMBER=

# ─── Meta Graph API (Instagram + Facebook publishing) ───────
# MOCK until App Review clears. Set GRAPH_MODE=live once approved.
GRAPH_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# META_WEBHOOK_VERIFY_TOKEN=

# ─── Optional destinations (platformConfigured mock fallback) ─
# X / Threads: live only when app id is set AND the brand has connected tokens.
# Until then LiveGraphAdapter falls back to the mock feed.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# ─── LinkedIn Company Page (Posts API) ──────────────────────
# Live once LINKEDIN_CLIENT_ID + brand org tokens exist (platformConfigured('linkedin')).
# Marketing Developer Platform / partner approval + Company Page admin required externally.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ─── TikTok Content Posting (Direct Post) ───────────────────
# Live once TIKTOK_CLIENT_KEY + brand tokens exist.
# Without TIKTOK_AUDIT_PASSED, public posts are forced to SELF_ONLY (private).
# Set TIKTOK_AUDIT_PASSED=true only after Content Posting API audit clears.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_AUDIT_PASSED=

# ─── Replicate / fal (image edit + AI video) ────────────────
# REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro
# FAL_KEY=
# Phase G4 AI video — leave models unset to disable (SMS refuse).
# AI_VIDEO_PROVIDER=replicate
# AI_VIDEO_PRIMARY_MODEL=
# AI_VIDEO_SECONDARY_MODEL=
# Cost caps (COST_*): soft USD estimates + monthly AI video budget logged on drain.
# COST_IMAGE_USD=0.04
# COST_VIDEO_USD=0.5
# COST_SPECIALTY_USD=0.12
# AI_VIDEO_COST_CAP_CENTS_MONTH=2000
# AI_VIDEO_EST_COST_CENTS=50
# AI_WEEKLY_SPEND_CAP_USD=10
# RETENTION_DAYS=180
#
# Phase G2 UGC — multi-model router (not locked to Nano Banana / Kling).
# Stills: nano_banana | flux_dev | seedream
# UGC_STILL_MODEL=nano_banana
# UGC_STILL_FALLBACKS=flux_dev,seedream
# Motion: kling | seedance | wan
# UGC_MOTION_MODEL=kling
# UGC_MOTION_FALLBACKS=seedance,wan
# Set UGC_MOTION_MODEL=seedance to prefer Seedance over Kling (not locked to Nano Banana/Kling).
# Optional fal path overrides:
# FAL_NANO_BANANA_MODEL=fal-ai/nano-banana
# FAL_FLUX_STILL_MODEL=fal-ai/flux/dev
# FAL_SEEDREAM_MODEL=fal-ai/bytedance/seedream/v4/text-to-image
# FAL_KLING_I2V_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# FAL_SEEDANCE_I2V_MODEL=fal-ai/bytedance/seedance/v1/pro/image-to-video
# FAL_WAN_I2V_MODEL=fal-ai/wan/v2.1/image-to-video
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# UGC_EST_COST_CENTS=150
# UGC_TALKING_HEAD_ENABLED=false

# ─── Plans / Stripe ─────────────────────────────────────────
# Checkout is live when STRIPE_SECRET_KEY is set. Prices resolve via lookup
# keys kip_pro_month / kip_pro_year / kip_max_month / kip_max_year unless
# STRIPE_PRICE_* IDs are set to pin specific Price objects.
# Preview + Development: sk_test_ from the "Kip ai test" account. Never put
# sk_live_ on Preview (the app refuses live keys outside Production).
# Production: leave unset until go-live, then sk_live_ from "Kip Ai".
# See docs/STRIPE_SETUP.md.
# Do NOT set PLAN_ENFORCEMENT until Pro vs Max feature locks are ready —
# entitlements stay fully open (everyone gets the Max envelope).
# PLAN_ENFORCEMENT=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Optional pins (same lookup keys work across test + live accounts):
# STRIPE_PRICE_PRO_MONTH=
# STRIPE_PRICE_PRO_YEAR=
# STRIPE_PRICE_MAX_MONTH=
# STRIPE_PRICE_MAX_YEAR=
# Production webhook: https://<APP_BASE_URL>/api/webhooks/billing
# Prices must be AUD GST-inclusive ($79 / $149 / $756 / $1428). Do not enable
# Stripe Tax in a way that adds GST on top of those amounts.
# Customer Portal: allow Pro/Max × month/year switching; cancel at period end.

# ─── Security ───────────────────────────────────────────────
# 32-byte base64 key for encrypting platform_tokens at rest (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# ─── App ────────────────────────────────────────────────────
  APP_BASE_URL=http://localhost:3000
TZ=Australia/Sydney

# ─── Phase I CRM email fallback (optional) ──────────────────
# When a CRM webhook is unset or fails, Kip can email the lead card.
# EMAIL_FROM=kip@yourdomain.com
# EMAIL_TO=owner@yourdomain.com   # optional; else uses brand owner user email
# RESEND_API_KEY=                 # required to actually send when EMAIL_FROM is set

# ─── Vercel Web Analytics (operator Overview visitors) ─────
# Create a token at https://vercel.com/account/tokens with Read access.
# When set, operator Overview pulls visitors/pageviews from Vercel Web Analytics.
# Without it, Overview falls back to the first-party page_views beacon.
VERCEL_API_TOKEN=
# Optional overrides (defaults to the pulse-ai Vercel project):
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
