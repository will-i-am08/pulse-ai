{
  "name": "pulse-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev:web": "pnpm --filter @pulse/web dev",
    "dev:worker": "pnpm --filter @pulse/worker dev",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "sim": "tsx --env-file=.env scripts/sim.ts"
  },
  "devDependencies": {
    "@pulse/shared": "workspace:*",
    "@types/node": "22.10.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
